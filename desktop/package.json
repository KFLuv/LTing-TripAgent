{
  "name": "aitravelguide-desktop",
  "version": "1.1.9",
  "description": "AI旅游助手 本地桌面端（Electron 外壳 + 内嵌浏览器）",
  "main": "main.js",
  "scripts": {
    "jre": "node scripts/make-jre.js",
    "start": "electron .",
    "dist": "npm run jre && electron-builder --win portable"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "build": {
    "appId": "com.aitravelguide.desktop",
    "productName": "AITravelGuide",
    "artifactName": "LTing-${version}-免安装版.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/target/chat-gpt.jar",
        "to": "backend/chat-gpt.jar"
      },
      {
        "from": "build/jre",
        "to": "jre"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LTing-${version}-免安装版.${ext}"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release_app",
      "buildResources": "build"
    },
    "portable": {
      "artifactName": "LTing-${version}-免安装版.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
