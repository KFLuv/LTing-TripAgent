.d-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.d-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.n-time {
  font-size: 22rpx;
  color: #0071e3;
}

.n-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 4rpx 0;
}

.amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #0071e3;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 80;
}

.sheet {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
