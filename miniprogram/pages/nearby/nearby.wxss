.poi-img,
.poi-ph {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #f0f0f3;
}

.poi-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #86868b;
}

.poi-name {
  font-size: 30rpx;
  font-weight: 600;
}

.loc-btn {
  font-size: 24rpx;
  color: #0071e3;
  background: rgba(0, 113, 227, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  flex-shrink: 0;
}
