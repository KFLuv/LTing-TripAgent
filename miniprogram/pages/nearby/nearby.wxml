<view class="page">
  <view class="card">
    <view class="seg">
      <view class="seg-item {{radius === item.v ? 'on' : ''}}" wx:for="{{radiusOptions}}"
            wx:key="v" data-v="{{item.v}}" bindtap="setRadius">{{item.label}}</view>
    </view>
    <view class="field" style="margin-top:20rpx;margin-bottom:0">
      <input class="field-input" value="{{keyword}}" placeholder="搜店名 / 品类，如「麦当劳」「咖啡」"
             confirm-type="search" bindinput="onKeyword" bindconfirm="search" />
    </view>
    <view class="row-between" style="margin-top:12rpx">
      <view class="muted grow">{{locText}} · 查到 {{pois.length}} 家</view>
      <view class="loc-btn" bindtap="relocate">我的位置</view>
    </view>
  </view>

  <view class="card card-tight" wx:if="{{pois.length}}">
    <view class="list-item row" wx:for="{{pois}}" wx:key="poiId" data-id="{{item.poiId}}"
          bindtap="openDetail">
      <image class="poi-img" src="{{item.cover}}" mode="aspectFill" wx:if="{{item.cover}}" />
      <view class="poi-ph" wx:else>{{item.name[0]}}</view>
      <view class="grow" style="margin-left:20rpx">
        <view class="poi-name ellipsis">{{item.name}}</view>
        <view class="poi-addr ellipsis">{{item.city}} {{item.address}}</view>
        <view class="chips">
          <view class="tag tag-sm tag-warn" wx:if="{{item.rating}}">★ {{item.rating}}</view>
          <view class="tag tag-sm" wx:if="{{item.distanceText}}">{{item.distanceText}}</view>
          <view class="tag tag-sm" wx:if="{{item.cost}}">人均 {{item.cost}}</view>
        </view>
      </view>
    </view>
  </view>
  <view class="card empty" wx:elif="{{loading}}">正在查附近的店…</view>
  <view class="card empty" wx:else>这一圈没查到，换个半径或关键词再试。</view>
</view>
