.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(0, 113, 227, 0.1);
  color: #0071e3;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.p-name {
  font-size: 36rpx;
  font-weight: 700;
}

.pref-tag {
  font-size: 28rpx;
  font-weight: 600;
}

.chev {
  color: #c7c7cc;
  font-size: 40rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 80;
}

.sheet {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
