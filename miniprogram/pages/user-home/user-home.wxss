.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(0, 113, 227, 0.1);
  color: #0071e3;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.u-name {
  font-size: 30rpx;
  font-weight: 600;
}

.u-content {
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
