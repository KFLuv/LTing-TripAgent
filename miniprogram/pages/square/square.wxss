.m-user {
  font-size: 28rpx;
  font-weight: 600;
}

.m-content {
  margin: 12rpx 0;
  font-size: 29rpx;
  line-height: 1.6;
  word-break: break-word;
}

.m-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.m-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f0f0f3;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 80;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.ta {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  background: #f0f0f3;
  border-radius: 20rpx;
  font-size: 29rpx;
  margin-bottom: 20rpx;
}
