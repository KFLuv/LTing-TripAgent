<view class="page">
  <view class="seg">
    <view class="seg-item {{tab === 'square' ? 'on' : ''}}" data-t="square" bindtap="switchTab">广场</view>
    <view class="seg-item {{tab === 'mine' ? 'on' : ''}}" data-t="mine" bindtap="switchTab">我的动态</view>
    <view class="seg-item {{tab === 'friends' ? 'on' : ''}}" data-t="friends" bindtap="switchTab">好友</view>
  </view>

  <view class="card card-tight" wx:if="{{list.length}}">
    <view class="list-item" wx:for="{{list}}" wx:key="key"
          data-index="{{index}}" bindlongpress="removeMoment">
      <view class="row-between">
        <view class="m-user">{{item.nickname || item.username}}</view>
        <view class="row">
          <view class="tag {{item.visibility === 'public' ? 'tag-ok' : (item.visibility === 'friends' ? 'tag-brand' : '')}}">
            {{item.visText}}
          </view>
          <view class="muted">{{item.createTime}}</view>
        </view>
      </view>
      <view class="m-content">{{item.content}}</view>
      <view class="m-imgs" wx:if="{{item.images.length}}">
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="m-img"
               src="{{img}}" mode="aspectFill" data-i="{{index}}" data-urls="{{item.images}}"
               bindtap="previewImage" />
      </view>
      <view class="muted" wx:if="{{item.place}}">📍 {{item.place}}</view>
    </view>
  </view>
  <view class="card empty" wx:else>{{tab === 'square' ? '广场上还没有公开的动态' : '你还没有发过动态'}}</view>

  <view class="fab" bindtap="openPublish">＋ 发动态</view>

  <view class="mask" wx:if="{{publishing}}" bindtap="closePublish">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">发一条动态</view>
      <textarea class="ta" value="{{draft.content}}" placeholder="今天有什么值得记一笔的？"
                maxlength="500" bindinput="onContent" />
      <view class="field">
        <view class="field-label">地点（可空，默认带当前定位）</view>
        <input class="field-input" value="{{draft.place}}" bindinput="onPlace" placeholder="例如：广州塔" />
      </view>
      <view class="seg" style="margin-bottom:16rpx">
        <view class="seg-item {{draft.visibility === 'public' ? 'on' : ''}}" data-v="public" bindtap="setVis">公开</view>
        <view class="seg-item {{draft.visibility === 'friends' ? 'on' : ''}}" data-v="friends" bindtap="setVis">仅好友</view>
        <view class="seg-item {{draft.visibility === 'private' ? 'on' : ''}}" data-v="private" bindtap="setVis">仅自己</view>
      </view>
      <view class="row" style="gap:16rpx">
        <button class="btn btn-ghost" style="flex:1" bindtap="pick">选图（{{draft.images.length}}）</button>
        <button class="btn btn-primary" style="flex:1" bindtap="publish" disabled="{{!draft.content}}">发布</button>
      </view>
      <view class="m-imgs" wx:if="{{draft.images.length}}">
        <image wx:for="{{draft.images}}" wx:for-item="img" wx:key="*this" class="m-img" src="{{img}}" mode="aspectFill" />
      </view>
    </view>
  </view>
</view>
