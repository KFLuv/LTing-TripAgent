<view class="chat">
  <view class="chat-bar">
    <view class="grow ellipsis bar-title" bindlongpress="renameSession">{{title || '新对话'}}</view>
    <view class="bar-btn {{location.status === 'ok' ? 'on' : ''}}" bindtap="locate">
      {{location.status === 'locating' ? '定位中…' : (location.status === 'ok' ? '已定位' : '我的位置')}}
    </view>
    <view class="bar-btn" bindtap="openLocalMap">地图</view>
    <view class="bar-btn" bindtap="newSession">新会话</view>
    <view class="bar-btn" bindtap="openSessions">历史</view>
  </view>

  <!-- 定位结果：先扫描（定位中…），拿到后把地名与坐标显示出来 -->
  <view class="loc-line" wx:if="{{location.status === 'locating'}}">正在定位并解析地名…</view>
  <view class="loc-line ok" wx:elif="{{location.status === 'ok'}}" bindtap="locate">
    📍 {{location.name}}　<text class="loc-coord">{{location.lat}}, {{location.lng}}</text>（点这里重新定位）
  </view>
  <view class="loc-line fail" wx:elif="{{location.status === 'fail'}}">
    没拿到定位：{{location.error}}　<text bindtap="locate">重试</text> / <text bindtap="openSetting">去设置</text>
  </view>

  <view class="warn" wx:if="{{agentOff}}">
    后端没配 ai.api-key，当前是简易模式（仍可规划行程，但不会是真实大模型回答）。
  </view>

  <scroll-view class="chat-body" scroll-y scroll-into-view="{{intoView}}" scroll-with-animation>
    <view wx:if="{{!msgs.length}}" class="chat-empty">
      <view class="chat-empty-t">说一句想去哪，管家会读你的偏好档案再排行程</view>
      <view class="chips">
        <view class="chip" wx:for="{{quick}}" wx:key="*this" data-t="{{item}}" bindtap="useQuick">{{item}}</view>
      </view>
    </view>

    <view wx:for="{{msgs}}" wx:key="idx" id="m{{index}}" class="msg msg-{{item.role}}">
      <view class="bubble">
        <text user-select="true">{{item.text}}</text>
        <view class="nav-row" wx:if="{{item.nav}}">
          <view class="nav-btn" wx:if="{{!item.nav.link}}" data-i="{{index}}" bindtap="showMap">
            在本页看地图（{{item.nav.name || '目的地'}}）
          </view>
          <view class="nav-btn" wx:else data-i="{{index}}" bindtap="copyLink">复制导航链接</view>
        </view>
        <view class="actions" wx:if="{{item.actions.length}}">
          <view class="actions-t">本次为你做了 {{item.actions.length}} 件事</view>
          <view class="action" wx:for="{{item.actions}}" wx:for-item="a" wx:key="summary">· {{a.summary}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{sending}}" class="msg msg-ai">
      <view class="bubble typing">管家正在查库 / 调工具，最长可能几十秒…</view>
    </view>
    <view id="m-end" style="height:24rpx"></view>
  </scroll-view>

  <!-- 内嵌地图：就在对话里画出来，点它才弹成全屏地图 -->
  <view class="map-card" wx:if="{{map.show}}">
    <view class="map-head">
      <view class="grow ellipsis map-title">{{map.mine ? '我的位置' : ('目的地 · ' + (map.name || '导航'))}}</view>
      <view class="map-btn" bindtap="openFullMap">打开全屏地图</view>
      <view class="map-btn" bindtap="closeMap">收起</view>
    </view>
    <map class="imap" latitude="{{map.lat}}" longitude="{{map.lng}}" scale="14"
         show-location="{{true}}" circles="{{map.circles}}" polyline="{{map.polyline}}"
         bindtap="openFullMap" />
  </view>

  <view class="chat-input">
    <input class="chat-input-box" value="{{input}}" placeholder="想去哪、几个人、几天…"
           confirm-type="send" bindinput="onInput" bindconfirm="send" disabled="{{sending}}" />
    <button class="btn btn-primary btn-send" bindtap="send" disabled="{{sending || !input}}">发送</button>
  </view>
</view>
