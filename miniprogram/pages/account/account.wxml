<view class="page">
  <view class="card">
    <view class="muted">当前账号</view>
    <view class="a-name">{{user.name}}</view>
    <view class="muted">邮箱：{{user.email || '未绑定'}}</view>
  </view>

  <view class="section-title">改密码</view>
  <view class="card">
    <view class="field">
      <view class="field-label">当前密码</view>
      <input class="field-input" password="{{true}}" value="{{form.currentPassword}}" bindinput="on" data-k="currentPassword" />
    </view>
    <view class="field">
      <view class="field-label">新密码</view>
      <input class="field-input" password="{{true}}" value="{{form.newPassword}}" bindinput="on" data-k="newPassword" />
    </view>
    <view class="field">
      <view class="field-label">再输一次新密码</view>
      <input class="field-input" password="{{true}}" value="{{form.confirmPassword}}" bindinput="on" data-k="confirmPassword" />
    </view>
    <button class="btn btn-primary" bindtap="changePassword">保存新密码</button>
  </view>

  <view class="section-title">邮箱</view>
  <view class="card">
    <view class="field">
      <view class="field-label">绑定 / 换绑邮箱</view>
      <input class="field-input" value="{{form.newEmail}}" bindinput="on" data-k="newEmail" placeholder="name@example.com" />
    </view>
    <view class="field">
      <view class="field-label">用当前密码确认</view>
      <input class="field-input" password="{{true}}" value="{{form.currentPassword2}}" bindinput="on" data-k="currentPassword2" />
    </view>
    <view class="row" style="gap:16rpx">
      <button class="btn btn-primary" style="flex:1" bindtap="bindEmail">保存邮箱</button>
      <button class="btn btn-ghost" style="flex:1" bindtap="unbindEmail">解绑邮箱</button>
    </view>
  </view>

  <view class="section-title">注销账号</view>
  <view class="card">
    <view class="muted">会删掉这个账号下的行程、动态、打卡、偏好、评价等全部数据，删了找不回来。</view>
    <button class="btn" style="margin-top:20rpx;color:#ff3b30;background:rgba(255,59,48,.08)" bindtap="removeAccount">
      注销账号
    </button>
  </view>
</view>
