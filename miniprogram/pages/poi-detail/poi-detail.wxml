<view class="page" wx:if="{{poi}}">
  <scroll-view class="photos" scroll-x wx:if="{{poi.photos.length}}">
    <image wx:for="{{poi.photos}}" wx:key="*this" class="ph" src="{{item}}" mode="aspectFill"
           data-i="{{index}}" data-urls="{{poi.photos}}" bindtap="preview" />
  </scroll-view>
  <view class="ph-ph" wx:else>{{poi.name[0]}}</view>

  <view class="card">
    <view class="p-name">{{poi.name}}</view>
    <view class="row" style="gap:10rpx;flex-wrap:wrap;margin:12rpx 0">
      <view class="tag tag-warn" wx:if="{{poi.sourceRating}}">★ {{poi.sourceRating}}</view>
      <view class="tag" wx:if="{{poi.cost}}">人均 {{poi.cost}}</view>
      <view class="tag" wx:if="{{poi.distanceText}}">{{poi.distanceText}}</view>
      <view class="tag tag-brand" wx:if="{{poi.tag}}">{{poi.tag}}</view>
    </view>
    <view class="line" bindtap="copyAddress">
      <text class="k">地址</text>
      <text class="grow">{{poi.city}} {{poi.address}}</text>
      <text class="op">复制</text>
    </view>
    <view class="line" wx:if="{{poi.tel}}" bindtap="call">
      <text class="k">电话</text>
      <text class="grow">{{poi.tel}}</text>
      <text class="op">拨打</text>
    </view>
    <view class="line" wx:if="{{locText}}">
      <text class="k">我的位置</text>
      <text class="grow">{{locText}}</text>
      <text class="op" bindtap="relocate">重新定位</text>
    </view>
  </view>

  <view class="row" style="gap:16rpx;flex-wrap:wrap">
    <button class="btn btn-primary" style="flex:1;min-width:300rpx" bindtap="navigate">一键导航</button>
    <button class="btn btn-ghost" style="flex:1;min-width:300rpx" bindtap="goCheckin">在这里打卡</button>
    <button class="btn btn-ghost" style="flex:1;min-width:300rpx" bindtap="copyForDianping">复制店名+地址去点评搜</button>
  </view>

  <!-- 内嵌地图：不带图标的标记用圆圈 + 连线表达，红小圈=目的地，蓝线=我→店 -->
  <view class="section-title">位置（内嵌地图）</view>
  <view class="card" style="padding:0;overflow:hidden">
    <map class="imap" wx:if="{{poi.lat && poi.lng}}" latitude="{{poi.lat}}" longitude="{{poi.lng}}"
         scale="15" show-location="{{true}}" circles="{{circles}}" polyline="{{polyline}}"
         bindtap="navigate" />
    <view class="empty" wx:else>这家店没有返回坐标，开不了地图。</view>
  </view>

  <view class="section-title">菜单（{{menu.length}}）</view>
  <view class="card card-tight" wx:if="{{menu.length}}">
    <view class="list-item row-between" wx:for="{{menu}}" wx:key="name">
      <view class="grow">
        <view class="m-name">{{item.name}}</view>
        <view class="muted" wx:if="{{item.note}}">{{item.note}}</view>
      </view>
      <view class="amount">{{item.price}}</view>
    </view>
  </view>
  <view class="card empty" wx:else>这家还没有录入菜单。</view>

  <view class="section-title">打卡记录（{{logs.length}}）</view>
  <view class="card card-tight" wx:if="{{logs.length}}">
    <view class="list-item" wx:for="{{logs}}" wx:key="id">
      <view class="row-between">
        <view class="m-name">{{item.username}}</view>
        <view class="muted">{{item.createTime}}</view>
      </view>
      <view class="muted" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="tag tag-warn" wx:if="{{item.rating}}" style="margin-top:8rpx">★ {{item.rating}}</view>
    </view>
  </view>
  <view class="card empty" wx:else>还没有人在这里打卡。</view>

  <view class="section-title">点评（{{reviews.length}}）</view>
  <view class="card card-tight" wx:if="{{reviews.length}}">
    <view class="list-item" wx:for="{{reviews}}" wx:key="id">
      <view class="row-between">
        <view class="m-name">{{item.username}}</view>
        <view class="tag tag-warn" wx:if="{{item.rating}}">★ {{item.rating}}</view>
      </view>
      <view class="muted" style="margin-top:6rpx">{{item.content}}</view>
      <view class="muted">{{item.createTime}}</view>
    </view>
  </view>
  <view class="card empty" wx:else>还没有点评。写第一条。</view>
  <view class="card">
    <view class="row" style="gap:16rpx">
      <input class="field-input grow" style="background:#f0f0f3;border-radius:20rpx;padding:0 24rpx;height:80rpx"
             type="digit" value="{{myRating}}" placeholder="评分 1-5" bindinput="onRating" />
      <button class="btn btn-primary btn-mini" style="height:80rpx" bindtap="submitReview">发布点评</button>
    </view>
    <textarea class="ta" value="{{myContent}}" placeholder="这家店值不值？" maxlength="300" bindinput="onContent" />
  </view>
</view>
