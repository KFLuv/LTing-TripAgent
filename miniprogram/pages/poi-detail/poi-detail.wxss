.photos {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.ph {
  width: 420rpx;
  height: 280rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
  background: #f0f0f3;
}

.ph-ph {
  height: 240rpx;
  border-radius: 24rpx;
  background: #f0f0f3;
  color: #86868b;
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.p-name {
  font-size: 40rpx;
  font-weight: 700;
}

.line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  font-size: 28rpx;
}

.line .k {
  color: #86868b;
  width: 130rpx;
  flex-shrink: 0;
}

.line .op {
  color: #0071e3;
  font-size: 26rpx;
  padding-left: 16rpx;
}

.m-name {
  font-size: 28rpx;
  font-weight: 600;
}

.amount {
  font-size: 28rpx;
  color: #0071e3;
}

.ta {
  width: 100%;
  min-height: 150rpx;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  background: #f0f0f3;
  border-radius: 20rpx;
  font-size: 28rpx;
}
