/* ==========================================================================
   全局样式：与桌面端 frontend/assets/app.css 共用同一套设计令牌
   画布 f5f5f7 / 纯净白表面 / 克制蓝 #0071e3，全站无尖角（最小圆角 16rpx）
   ========================================================================== */
page {
  --bg: #f5f5f7;
  --panel: #ffffff;
  --muted-surface: #f0f0f3;
  --ink: #1d1d1f;
  --ink-2: #6e6e73;
  --muted: #86868b;
  --line: rgba(0, 0, 0, 0.08);
  --brand: #0071e3;
  --brand-soft: rgba(0, 113, 227, 0.08);
  --accent: #ff9500;
  --ok: #34c759;
  --danger: #ff3b30;
  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-lg: 32rpx;
  --r-pill: 999rpx;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--panel);
  border-radius: var(--r-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04), 0 0 0 1rpx rgba(0, 0, 0, 0.04);
}

.card-tight {
  padding: 0;
  overflow: hidden;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 32rpx 8rpx 16rpx;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.ink2 {
  color: var(--ink-2);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: var(--r-md);
  font-size: 32rpx;
  font-weight: 600;
  background: var(--muted-surface);
  color: var(--ink);
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-ghost {
  background: var(--panel);
  color: var(--brand);
  box-shadow: 0 0 0 1rpx rgba(0, 113, 227, 0.25);
}

.btn-mini {
  height: 60rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--r-pill);
}

.btn[disabled] {
  opacity: 0.45;
}

/* ---------- 表单 ---------- */
.field {
  background: var(--muted-surface);
  border-radius: var(--r-md);
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}

.field-input {
  font-size: 30rpx;
  height: 48rpx;
  width: 100%;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  background: var(--muted-surface);
  color: var(--ink-2);
  margin-right: 12rpx;
}

.tag-brand {
  background: var(--brand-soft);
  color: var(--brand);
}

.tag-ok {
  background: rgba(52, 199, 89, 0.12);
  color: #248a3d;
}

.tag-warn {
  background: rgba(255, 149, 0, 0.14);
  color: #a05a00;
}

/* ---------- 列表行 ---------- */
.list-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--panel);
}

.list-item:last-child {
  border-bottom: none;
}

.empty {
  padding: 96rpx 32rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* ---------- 分段控制 ---------- */
.seg {
  display: flex;
  background: var(--muted-surface);
  border-radius: var(--r-pill);
  padding: 6rpx;
  gap: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  border-radius: var(--r-pill);
}

.seg-item.on {
  background: var(--panel);
  color: var(--brand);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  height: 96rpx;
  padding: 0 40rpx;
  border-radius: var(--r-pill);
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 113, 227, 0.35);
  z-index: 20;
}

.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(245, 245, 247, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
